PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET_KEY=your_secure_jwt_signing_secret
FRONTEND_URL=http://localhost:5173
COOKIE_NAME=newsfront_admin_token
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Future ImageKit Integration (Phase 2+)
IMAGE_KIT_PUBLIC_KEY=your_imagekit_public_key
IMAGE_KIT_PRIVATE_KEY=your_imagekit_private_key
URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGE_KIT_ID=your_id

# Initial Admin Bootstrap Configuration (Phase 9 Master Sync)
ADMIN_NAME="Super Administrator"
ADMIN_EMAIL="admin@newsfront.com"
ADMIN_PASSWORD="YourSecureAdminPassword123!"

# Transactional email. Keep credentials server-side. Port 465 uses implicit TLS;
# other ports use STARTTLS (required in production). An internal relay may omit auth.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Existing Brevo aliases SMTP_Server and SMTP_Key are also supported for host/key.
# SMTP_USER must be the exact login shown on Brevo's SMTP settings page.
# SMTP_FROM must use a sender configured/verified in Brevo.

# persistent: the Node server runs a 60-second worker after MongoDB connects.
# external: disable the interval and configure your host scheduler to POST to
# /api/internal/publish-scheduled with Authorization: Bearer <SCHEDULER_SECRET>.
SCHEDULER_MODE=persistent
SCHEDULER_SECRET=

